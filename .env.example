# Vercel / Upstash room signaling
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# Vercel Marketplace連携では、代わりに次の名前が自動追加される場合があります。
# URLはUPSTASH_REDIS_REST_URL、KV_REST_API_URLの順で使用します。
# TokenはUPSTASH_REDIS_REST_TOKEN、KV_REST_API_TOKENの順で使用します。
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=replace-with-vercel-kv-rest-token
SIGNALING_SECRET=replace-with-at-least-32-random-characters
SIGNALING_ALLOWED_ORIGINS=
SIGNALING_ROOM_TTL_SECONDS=600

# Per-IP, Redis-shared rate limits
SIGNALING_CREATE_LIMIT=6
SIGNALING_CREATE_WINDOW_SECONDS=60
SIGNALING_JOIN_LIMIT=30
SIGNALING_JOIN_WINDOW_SECONDS=60
SIGNALING_REQUEST_TIMEOUT_MS=10000

# WebRTC ICE configuration returned by GET /api/network-config.
# Include both STUN and TURN. TURN credentials are necessarily delivered to clients.
WEBRTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.example.com:3478"},{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"],"username":"replace-me","credential":"replace-me"}]
WEBRTC_ICE_TRANSPORT_POLICY=all
WEBRTC_ICE_GATHER_TIMEOUT_MS=12000
WEBRTC_CONNECTION_TIMEOUT_MS=30000
